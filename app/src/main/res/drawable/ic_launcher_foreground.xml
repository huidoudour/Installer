<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        n2 定稿：三层等轴测斜片 + 贯穿箭头。
        绘制顺序 粉 → 橙 → 箭头 → 蓝：箭头杆顶被最前面的蓝片挡住，
        读作“框在前、箭头藏在层叠内部”，只在橙 / 粉层内露出。
        全部图形落在中心 66dp 安全圆内。白底由 ic_launcher_background 提供。
    -->

    <!-- 底层斜片：樱花粉 -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFB6C1"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M31,65 L54,76 L77,65 L54,54 Z"/>

    <!-- 中层斜片：橙 -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF9800"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M31,54 L54,65 L77,54 L54,43 Z"/>

    <!-- 安装箭头：圆头杆 + 开放 V 头，杆顶藏到蓝片后面 -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#4CAF50"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,39 V71 M54,71 L47,64 M54,71 L61,64"/>

    <!-- 顶层斜片：蓝（最前面的“框”，遮住箭头杆顶） -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#2196F3"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M31,43 L54,54 L77,43 L54,32 Z"/>
</vector>
